# No Railway: serviço do bot -> Variables. Nunca comitar valores reais.
DATABASE_URL=${{Postgres.DATABASE_URL}}
AUTOCAB_KEY=                    # Ocp-Apim-Subscription-Key
EVOLUTION_URL=http://${{Evolution API.RAILWAY_PRIVATE_DOMAIN}}:8080   # confira nome do serviço e porta no Railway
EVOLUTION_KEY=                  # apikey global da Evolution
EVOLUTION_INSTANCIA=            # nome da instância conectada ao WhatsApp
BASE_URL=https://seu-bot.up.railway.app   # domínio público deste serviço; vai no link /r/{token}
WEBHOOK_SECRET=                 # string aleatória longa; vai na URL do webhook: /webhooks/evolution?s=...
# INTERVALO_MS=15000            # opcional, intervalo de consulta ao Autocab
